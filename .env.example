# ==============================================================================
# PR Reviewer Bot — Environment Configuration
# ==============================================================================
# Copy this file to .env and configure values before starting the service:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Settings
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. GitHub App Authentication
# ------------------------------------------------------------------------------
# Created at: https://github.com/settings/apps
# Required permissions:
#   - Pull requests: Read & write
#   - Contents: Read
#   - Metadata: Read
GITHUB_APP_ID=5726031
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Engine
# ------------------------------------------------------------------------------
# Generated at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Local Webhook Proxy Tunnel (Optional - for local development)
# ------------------------------------------------------------------------------
# Create a free webhook forwarder channel at: https://smee.io
SMEE_URL=https://smee.io/your_channel_hash_here

# ------------------------------------------------------------------------------
# 5. Dashboard Security & Authentication
# ------------------------------------------------------------------------------
# Password used to authenticate access to /dashboard and telemetry APIs (/api/*)
DASHBOARD_PASSWORD=change_this_to_a_secure_password
